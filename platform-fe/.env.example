# Copy to .env (or .env.<mode>) and fill in the values.
# Env files are gitignored — never commit real values.

NODE_ENV=dev

# Backend API base URL
VITE_APP_API=https://dev.api.example.com
VITE_APP_HEARTLAND_KEY=

# Contact info
VITE_APP_PHONE=+1 000 000 0000
VITE_APP_EMAIL=info@example.com
VITE_APP_ADDRESS=123 Main Street, City ST, 00000, United States

# Social links
VITE_APP_INSTAGRAM=https://www.instagram.com/example/
VITE_APP_FACEBOOK=https://www.facebook.com/example

# Mailchimp subscribe form URL
VITE_APP_MAILCHIMP_URL=

# API endpoints
VITE_APP_CARS_LIST_ENDPOINT=/vehicles/platform
VITE_APP_CARS_LIST_RANDOM_ENDPOINT=/vehicles/platform/random
