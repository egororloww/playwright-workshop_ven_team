{
  "name": "elite-fleet-group-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": "git@github.com:engenious-inc/elite-fleet-group-platform-fe.git",
  "scripts": {
    "host": "vite --host --mode dev",
    "dev": "vite --mode dev",
    "staging": "vite --mode staging",
    "production": "vite --mode production",
    "build:dev": "tsc && vite build --mode dev",
    "build:staging": "tsc && vite build --mode staging",
    "build:production": "tsc && vite build --mode production",
    "build:test": "tsc && vite build --mode test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@szhsin/react-accordion": "^1.2.3",
    "@szhsin/react-menu": "^4.1.0",
    "@tanstack/react-query": "^5.17.9",
    "@tanstack/react-query-devtools": "^5.17.9",
    "add": "^2.0.6",
    "axios": "^1.6.5",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "react": "^18.2.0",
    "react-datepicker": "^5.1.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.3",
    "react-mailchimp-subscribe": "^2.1.3",
    "react-modal": "^3.16.1",
    "react-modern-drawer": "^1.2.2",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^6.21.2",
    "react-select": "^5.8.0",
    "react-toastify": "^9.1.3",
    "swiper": "^11.0.6",
    "yarn": "^1.22.21",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-datepicker": "^4.19.5",
    "@types/react-dom": "^18.2.17",
    "@types/react-mailchimp-subscribe": "^2.1.4",
    "@types/react-modal": "^3.16.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": ">=6",
    "lint-staged": ">=10",
    "prettier": "^3.1.1",
    "sass": "^1.69.7",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-svgr": "^4.2.0"
  }
}
